function showProspectStatus(message, type = "info") {

  prospectStatus.style.display = "block";

  prospectStatus.textContent = message;

  if (type === "error") {

    prospectStatus.style.background =
      "rgba(255,92,92,.08)";

    prospectStatus.style.border =
      "1px solid rgba(255,92,92,.18)";

    prospectStatus.style.color =
      "#ff8585";

  } else {

    prospectStatus.style.background =
      "rgba(25,216,116,.08)";

    prospectStatus.style.border =
      "1px solid rgba(25,216,116,.15)";

    prospectStatus.style.color =
      "#19d874";

  }

}


function escapeHtml(value) {

  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


function getProspectPhone(result) {

  return (
    result.phone ||
    result.phoneNumber ||
    result.whatsapp ||
    result.mobile ||
    ""
  );

}


function getProspectCompany(result) {

  return (
    result.title ||
    result.name ||
    result.company ||
    ""
  );

}


function getProspectCategory(result) {

  return (
    result.categoryName ||
    result.category ||
    "Other"
  );

}


function getProspectAddress(result) {

  return (
    result.address ||
    result.location ||
    ""
  );

}


