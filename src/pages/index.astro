---
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>CRM Leads</title>

		<style>
		.card-detail {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 14px;
	border: 1px solid var(--border);
	background: #0a0f15;
	border-radius: 10px;
}

.card-detail span {
	color: var(--muted);
	font-size: 12px;
}

.card-detail strong {
	color: white;
	font-size: 13px;
}
			:root {
				--bg: #080b10;
				--panel: #10161e;
				--panel-2: #0d1219;
				--border: #222b37;
				--text: #f3f5f7;
				--muted: #8993a1;
				--green: #20d98b;
				--green-dark: #0c9f68;
				--yellow: #e6b85c;
				--purple: #a879ff;
				--blue: #63a8ff;
				--red: #ff6f7d;
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--bg);
			}

			body {
				margin: 0;
				background:
					radial-gradient(circle at 80% 0%, rgba(32, 217, 139, 0.06), transparent 28%),
					var(--bg);
				color: var(--text);
				font-family:
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					sans-serif;
			}

			button,
			input,
			select {
				font: inherit;
			}

			button {
				cursor: pointer;
			}

			.app {
				display: flex;
				min-height: 100vh;
			}

			/* SIDEBAR */

			.sidebar {
				width: 240px;
				min-height: 100vh;
				border-right: 1px solid var(--border);
				background: #0a0e13;
				padding: 26px 16px;
				position: fixed;
				left: 0;
				top: 0;
				bottom: 0;
			}

			.logo {
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 4px 12px 32px;
				font-weight: 800;
				letter-spacing: 1.5px;
			}

			.logo-mark {
	width: 32px;
	height: 32px;
	display: grid;
	place-items: center;
	border-radius: 9px;
	overflow: hidden;
	flex-shrink: 0;
	background: transparent;
}

.logo-mark img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	display: block;
}

			.logo span {
				font-size: 15px;
			}

			.nav-title {
				padding: 0 12px;
				margin-bottom: 10px;
				font-size: 11px;
				font-weight: 700;
				color: #586271;
				letter-spacing: 1.5px;
				text-transform: uppercase;
			}

			.nav {
				display: grid;
				gap: 5px;
			}

			.nav button {
				border: 0;
				background: transparent;
				color: var(--muted);
				text-align: left;
				padding: 12px;
				border-radius: 10px;
				display: flex;
				align-items: center;
				gap: 12px;
				transition: 0.2s;
			}

			.nav button:hover,
			.nav button.active {
				background: #151c25;
				color: white;
			}

			.nav button.active {
				box-shadow: inset 3px 0 0 var(--green);
			}

			.nav-icon {
				width: 22px;
				text-align: center;
			}

			.sidebar-bottom {
				position: absolute;
				left: 16px;
				right: 16px;
				bottom: 22px;
			}

			.user-card {
				padding: 13px;
				border: 1px solid var(--border);
				border-radius: 12px;
				background: var(--panel);
				display: flex;
				gap: 10px;
				align-items: center;
			}

			.avatar {
				width: 34px;
				height: 34px;
				border-radius: 50%;
				display: grid;
				place-items: center;
				background: #1c2632;
				font-size: 12px;
				font-weight: 800;
			}

			.user-name {
				font-size: 13px;
				font-weight: 700;
			}

			.user-role {
				font-size: 11px;
				color: var(--muted);
				margin-top: 2px;
			}

			/* MAIN */

			.main {
				width: calc(100% - 240px);
				margin-left: 240px;
				padding: 34px 40px 60px;
			}

			.topbar {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 30px;
			}

			.eyebrow {
				color: #697383;
				font-size: 12px;
				font-weight: 800;
				letter-spacing: 2.5px;
				margin-bottom: 8px;
			}

			h1 {
				margin: 0;
				font-size: clamp(30px, 4vw, 46px);
				letter-spacing: -1.8px;
				line-height: 1;
			}

			.subtitle {
				color: var(--muted);
				margin: 12px 0 0;
				font-size: 14px;
			}

			.top-actions {
				display: flex;
				gap: 10px;
			}

			.icon-button {
				width: 46px;
				height: 46px;
				border-radius: 13px;
				border: 1px solid var(--border);
				background: var(--panel);
				color: white;
			}

			.primary {
				border: 0;
				background: var(--green);
				color: #06130d;
				font-weight: 800;
				padding: 0 18px;
				border-radius: 12px;
				height: 46px;
			}

			.primary:hover {
				background: #32e39a;
			}

			/* STAT CARDS */

			.stats {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 16px;
			margin-bottom: 20px;
			width: 100%;
			}

			.stat {
			position: relative;
			overflow: hidden;
			background: var(--panel);
			border: 1px solid var(--border);
			border-radius: 16px;
			padding: 20px;
			min-height: 145px;
			width: 100%;
			}

			.stat::after {
				content: "";
				position: absolute;
				width: 90px;
				height: 90px;
				right: -30px;
				bottom: -40px;
				border-radius: 50%;
				background: var(--accent);
				opacity: 0.06;
			}

			.stat-top {
				display: flex;
				justify-content: space-between;
				color: #a5aebb;
				font-size: 14px;
				font-weight: 700;
			}

			.stat-icon {
				font-size: 20px;
				color: var(--accent);
			}

			.stat-number {
			font-size: 34px;
			font-weight: 850;
			margin-top: 14px;
			letter-spacing: -1px;
			}

			.stat-description {
				color: #697383;
				font-size: 12px;
				margin-top: 4px;
			}

			/* PANEL */

			.panel {
				background: var(--panel);
				border: 1px solid var(--border);
				border-radius: 20px;
				overflow: hidden;
			}

		.panel-header {
	padding: 16px 20px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 16px;
}

			.panel-title {
	font-size: 17px;
	font-weight: 800;
}

		.panel-description {
	color: var(--muted);
	font-size: 12px;
	margin-top: 3px;
}

			.toolbar {
	padding: 0 20px 14px;
	display: flex;
	gap: 8px;
}

			.search {
				flex: 1;
				position: relative;
			}

			.search span {
				position: absolute;
				left: 15px;
				top: 50%;
				transform: translateY(-50%);
				color: #697383;
			}

		.search input,
.filter {
	width: 100%;
	height: 42px;
	border: 1px solid var(--border);
	background: #0a0f15;
	color: white;
	border-radius: 10px;
	outline: none;
}

			.search input {
				padding: 0 15px 0 42px;
			}

			.search input:focus,
			.filter:focus {
				border-color: #405064;
			}

			.filter {
	width: 170px;
	padding: 0 12px;
}

			.table-wrap {
				overflow-x: auto;
				border-top: 1px solid var(--border);
			}

.table-wrap {
	overflow-x: auto;
	border-top: 1px solid var(--border);
}

:global(table) {
	width: 100%;
	border-collapse: collapse;
	min-width: 1000px;
	table-layout: fixed;
}

:global(table th) {
	text-align: left;
	color: #697383;
	font-size: 10px;
	letter-spacing: 1.2px;
	padding: 13px 20px;
	background: #0c1117;
}

:global(table td) {
	padding: 13px 20px;
	border-top: 1px solid #1b232e;
	color: #c8ced6;
	font-size: 13px;
	height: 58px;
	white-space: nowrap;
}

/* KOLOM PERUSAHAAN */
:global(table th:nth-child(1)),
:global(table td:nth-child(1)) {
	width: 24%;
	padding-left: 32px;
}

/* PIC */
:global(table th:nth-child(2)),
:global(table td:nth-child(2)) {
	width: 17%;
}

/* KOTA */
:global(table th:nth-child(3)),
:global(table td:nth-child(3)) {
	width: 17%;
}

/* WHATSAPP */
:global(table th:nth-child(4)),
:global(table td:nth-child(4)) {
	width: 16%;
}

/* STATUS */
:global(table th:nth-child(5)),
:global(table td:nth-child(5)) {
	width: 17%;
}

/* AKSI */
:global(table th:nth-child(6)),
:global(table td:nth-child(6)) {
	width: 9%;
	padding-right: 32px;
}

:global(tr:hover td) {
	background: #121922;
}

			tr:hover td {
				background: #121922;
			}

	.company {
	color: white;
	font-weight: 800;
}

.lead-link {
	border: 0;
	background: transparent;
	padding: 0;
	cursor: pointer;
	text-align: left;
	color: white;
	font-weight: 800;
}

.lead-link:hover {
	text-decoration: underline;
	color: var(--green);
}

.pic {
	font-size: 13px;
	color: #aeb6c2;
	margin: 0;
}

			.status {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				padding: 6px 9px;
				border-radius: 20px;
				font-size: 11px;
				font-weight: 700;
			}

			.status::before {
				content: "";
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: currentColor;
			}

			.status.new {
				color: var(--yellow);
				background: rgba(230, 184, 92, 0.09);
			}

			.status.contacted {
				color: var(--green);
				background: rgba(32, 217, 139, 0.08);
			}

			.status.followup {
				color: var(--purple);
				background: rgba(168, 121, 255, 0.09);
			}

			.status.closed {
				color: var(--blue);
				background: rgba(99, 168, 255, 0.09);
			}

			.whatsapp {
				border: 1px solid #1d7654;
				color: var(--green);
				background: transparent;
				padding: 7px 11px;
				border-radius: 8px;
				font-size: 11px;
				font-weight: 700;
			}

			.whatsapp:hover {
				background: rgba(32, 217, 139, 0.08);
			}

			.action {
				border: 0;
				background: transparent;
				color: #7e8998;
				font-size: 18px;
			}

			/* MODAL */

			.modal {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.7);
				display: none;
				align-items: center;
				justify-content: center;
				padding: 20px;
				z-index: 20;
			}

			.modal.open {
				display: flex;
			}

			.modal-box {
				width: min(500px, 100%);
				background: #111820;
				border: 1px solid var(--border);
				border-radius: 18px;
				padding: 24px;
				box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
			}

			.modal-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 22px;
			}

			.modal-title {
				font-size: 21px;
				font-weight: 800;
			}

			.close {
				border: 0;
				background: #19212b;
				color: #aab2bd;
				width: 35px;
				height: 35px;
				border-radius: 9px;
			}

			.form-grid {
				display: grid;
				gap: 14px;
			}

			label {
				display: grid;
				gap: 7px;
				color: #9aa4b2;
				font-size: 12px;
				font-weight: 700;
			}

			label input,
			label select {
				height: 44px;
				border: 1px solid var(--border);
				background: #0a0f15;
				color: white;
				border-radius: 9px;
				padding: 0 12px;
				outline: none;
			}

			.modal-footer {
				display: flex;
				justify-content: flex-end;
				gap: 10px;
				margin-top: 22px;
			}

			.secondary {
				height: 44px;
				padding: 0 16px;
				border-radius: 9px;
				border: 1px solid var(--border);
				background: transparent;
				color: #c4cad2;
			}

			/* MOBILE */

		
		@media (max-width: 800px) {
	.sidebar {
		display: none;
	}

	.main {
		width: 100%;
		margin-left: 0;
		padding: 24px 16px 40px;
	}

	.topbar {
		align-items: center;
	}

	.top-actions .primary {
		display: none;
	}

	.stats {
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 10px;
}

				.stat {
					padding: 17px;
					min-height: 130px;
				}

				.stat-number {
					font-size: 30px;
				}

				.panel-header {
	padding: 18px 20px 14px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 16px;
}

.panel-title {
	font-size: 18px;
	font-weight: 800;
}

.panel-description {
	color: var(--muted);
	font-size: 12px;
	margin-top: 4px;
}

.toolbar {
	padding: 0 20px 14px;
	display: flex;
	gap: 8px;
}

				.filter {
					width: 100%;
				}
			}

			@media (max-width: 480px) {
				.stats {
					grid-template-columns: 1fr;
				}

				h1 {
					font-size: 31px;
				}
			}

.activity-section {
	margin-top: 24px;
	padding-top: 20px;
	border-top: 1px solid var(--border);
}

.activity-title {
	font-size: 11px;
	font-weight: 800;
	letter-spacing: 1.2px;
	color: #697383;
	margin-bottom: 14px;
}

.activity-list {
	display: grid;
	gap: 10px;
}

.activity-item {
	padding: 12px;
	border: 1px solid var(--border);
	border-radius: 10px;
	background: #0a0f15;
}

.activity-item strong {
	display: block;
	color: white;
	font-size: 12px;
	margin-bottom: 5px;
}

.activity-item p {
	margin: 0;
	color: #aeb6c2;
	font-size: 12px;
	line-height: 1.5;
}

.activity-date {
	margin-top: 7px;
	color: #697383;
	font-size: 10px;
}

.activity-empty {
	color: #697383;
	font-size: 12px;
}
/* GLOBAL STYLE UNTUK TABEL DINAMIS */

:global(.company) {
	color: white;
	font-weight: 800;
	border: 0;
	background: transparent;
	padding: 0;
	cursor: pointer;
	text-align: left;
}

:global(.lead-link:hover) {
	text-decoration: underline;
	color: var(--green);
}

:global(.pic) {
	font-size: 12px;
	color: var(--muted);
	margin-top: 4px;
}

:global(.whatsapp) {
	border: 1px solid #1d7654;
	color: var(--green);
	background: transparent;
	padding: 7px 11px;
	border-radius: 8px;
	font-size: 11px;
	font-weight: 700;
	cursor: pointer;
}

:global(.whatsapp:hover) {
	background: rgba(32, 217, 139, 0.08);
}

:global(.status) {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	padding: 6px 9px;
	border-radius: 20px;
	font-size: 11px;
	font-weight: 700;
}

:global(.status::before) {
	content: "";
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: currentColor;
}

:global(.status.new) {
	color: var(--yellow);
	background: rgba(230, 184, 92, 0.09);
}

:global(.status.contacted) {
	color: var(--green);
	background: rgba(32, 217, 139, 0.08);
}

:global(.status.followup) {
	color: var(--purple);
	background: rgba(168, 121, 255, 0.09);
}

:global(.status.closed) {
	color: var(--blue);
	background: rgba(99, 168, 255, 0.09);
}

:global(.action) {
	border: 0;
	background: transparent;
	color: #7e8998;
	font-size: 12px;
	cursor: pointer;
	padding: 4px 6px;
}

:global(.action:hover) {
	color: white;
}

.activity-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	margin-bottom: 14px;
}

.activity-add {
	border: 1px solid rgba(32, 217, 139, 0.35);
	background: rgba(32, 217, 139, 0.08);
	color: var(--green);
	padding: 7px 11px;
	border-radius: 8px;
	font-size: 11px;
	font-weight: 700;
	cursor: pointer;
}

.activity-add:hover {
	background: rgba(32, 217, 139, 0.14);
}

/* =========================
   FOLLOW UP
========================= */

:global(.followup-summary) {
	display: flex;
	align-items: baseline;
	gap: 6px;
	margin-bottom: 16px;
	color: #697383;
}

:global(.followup-summary strong) {
	color: white;
	font-size: 16px;
}

:global(.followup-list) {
	display: grid;
	gap: 12px;
	padding: 0 20px 20px;
}

:global(.followup-card) {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 24px;
	padding: 18px 20px;
	background: #0a0f15;
	border: 1px solid var(--border);
	border-radius: 12px;
	min-height: 92px;
	transition: 0.2s ease;
}

:global(.followup-card:hover) {
	background: #101720;
	border-color: #344151;
}

:global(.followup-main) {
	min-width: 0;
	flex: 1;
}

:global(.followup-company) {
	font-size: 15px;
	font-weight: 800;
	color: white;
	margin-bottom: 5px;
}

:global(.followup-pic) {
	font-size: 12px;
	color: #9aa4b2;
	margin-bottom: 9px;
}

:global(.followup-pic strong) {
	color: #dce2e9;
}

:global(.followup-meta) {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 16px;
	font-size: 12px;
	color: #8993a1;
}

:global(.followup-right) {
	display: flex;
	align-items: center;
	gap: 14px;
	flex-shrink: 0;
}

:global(.followup-status) {
	font-size: 12px;
	font-weight: 700;
	color: var(--purple);
	white-space: nowrap;
}

:global(.followup-right .whatsapp) {
	min-width: 78px;
	text-align: center;
}

/* MOBILE */

@media (max-width: 700px) {
	:global(.followup-card) {
		align-items: flex-start;
		flex-direction: column;
		gap: 14px;
	}

	:global(.followup-right) {
		width: 100%;
		justify-content: space-between;
	}

	:global(.followup-meta) {
		gap: 10px;
	}
}

.followup-main {
	min-width: 0;
}

.followup-company {
	font-size: 17px;
	font-weight: 700;
	color: #202938;
	margin-bottom: 7px;
}

.followup-pic {
	font-size: 13px;
	color: #697383;
	margin-bottom: 8px;
}

.followup-meta {
	display: flex;
	flex-wrap: wrap;
	gap: 14px;
	font-size: 13px;
	color: #697383;
}

.followup-right {
	display: flex;
	align-items: center;
	gap: 14px;
	flex-shrink: 0;
}

.followup-status {
	font-size: 13px;
	font-weight: 600;
	color: #7653c7;
	white-space: nowrap;
}

@media (max-width: 700px) {
	.followup-card {
		align-items: flex-start;
		flex-direction: column;
	}

	.followup-right {
		width: 100%;
		justify-content: space-between;
	}
}

.report-grid {
	display: grid;
	grid-template-columns: repeat(5, 1fr);
	gap: 16px;
	margin-top: 24px;
}

.report-card {
	padding: 20px;
	background: #151b24;
	border: 1px solid #27303d;
	border-radius: 14px;
	min-height: 110px;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

.report-card span {
	font-size: 13px;
	color: #8d98a8;
}

.report-card strong {
	font-size: 32px;
	line-height: 1;
	color: #f4f7fb;
	margin-top: 14px;
}

@media (max-width: 1000px) {
	.report-grid {
		grid-template-columns: repeat(3, 1fr);
	}
}

