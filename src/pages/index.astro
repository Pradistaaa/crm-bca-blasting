                            background:rgba(25,216,116,.07);
                            border:1px solid rgba(25,216,116,.12);
                            padding:5px 8px;
                            border-radius:7px;
                            font-size:9px;
                          ">
                            📱 ${escapeHtml(phone)}
                          </span>
                        `
                        : ""
                    }

                    ${
                      website
                        ? `
                          <span style="
                            color:#6ea8ff;
                            background:rgba(110,168,255,.07);
                            border:1px solid rgba(110,168,255,.12);
                            padding:5px 8px;
                            border-radius:7px;
                            font-size:9px;
