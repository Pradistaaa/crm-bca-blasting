function populateLeadFilters() {

  const categories = [
    ...new Set(
      leads
        .map(lead => lead.category)
        .filter(Boolean)
    )
  ];

  leadCategoryFilter.innerHTML =
    `<option value="">Semua Kategori</option>` +
    categories
      .sort()
      .map(category =>
        `<option value="${category}">
          ${category}
        </option>`
      )
      .join("");


  const statuses = [
    ...new Set(
      leads
        .map(lead => lead.status)
        .filter(Boolean)
    )
  ];

  leadStatusFilter.innerHTML =
    `<option value="">Semua Status</option>` +
    statuses
      .map(status => {

        let label = "New";

        if (status === "contacted") {
          label = "Sudah Dihubungi";
        }

        if (status === "follow") {
          label = "Follow-up";
        }

        if (status === "deal") {
          label = "Deal";
        }

        return `
          <option value="${status}">
            ${label}
          </option>
        `;

      })
      .join("");

}

function applyLeadFilters() {

  const search =
    (leadSearch?.value || "")
      .toLowerCase()
      .trim();

  const category =
    leadCategoryFilter?.value || "";

  const status =
    leadStatusFilter?.value || "";


  const table =
    document.getElementById("allLeadsTable");

  if (!table) return;


  table.innerHTML = "";


  leads.forEach((lead, index) => {

    const company =
      String(lead.company || "")
        .toLowerCase();

    const pic =
      String(lead.pic || "")
        .toLowerCase();

    const whatsapp =
      String(lead.whatsapp || "")
        .toLowerCase();


    const matchSearch =
      !search ||
      company.includes(search) ||
      pic.includes(search) ||
      whatsapp.includes(search);


    const matchCategory =
      !category ||
      lead.category === category;


    const matchStatus =
      !status ||
      lead.status === status;


    if (
      !matchSearch ||
      !matchCategory ||
      !matchStatus
    ) {
      return;
    }


    const row =
      document.createElement("tr");


    let statusText = "New";
    let statusClass = "status-new";


    if (lead.status === "follow") {
      statusText = "Follow-up";
      statusClass = "status-follow";
    }

    if (lead.status === "contacted") {
      statusText = "Sudah Dihubungi";
      statusClass = "status-contacted";
    }

    if (lead.status === "meeting") {
      statusText = "Meeting";
      statusClass = "status-meeting";
    }


    if (lead.status === "deal") {
      statusText = "Deal";
      statusClass = "status-deal";
    }


    const whatsappNumber =
      String(lead.whatsapp || "")
        .replace(/\D/g, "");


    row.innerHTML = `

      <td>
        <div class="company">

          <div class="company-logo">
            ${(lead.company || "?")
              .charAt(0)
              .toUpperCase()}
          </div>

          <div class="company-info">
            <strong>
              ${lead.company || "-"}
            </strong>
          </div>

        </div>
      </td>


      <td>
        <span class="pic-name">
          ${lead.pic || "-"}
        </span>
      </td>


      <td>
        ${
          lead.whatsapp
            ? `
              <a
                class="whatsapp-link"
                href="https://wa.me/${whatsappNumber}"
                target="_blank"
                rel="noopener noreferrer"
                data-whatsapp-id="${lead.id}"
              >
                📱 ${lead.whatsapp}
              </a>
            `
            : `
              <span style="color:#68756d;font-size:10px;">
                Belum ada
              </span>
            `
        }
      </td>


      <td>
        <span class="category-text">
          ${lead.category || "-"}
        </span>
      </td>


      <td>
        <span class="status ${statusClass}">
          ${statusText}
        </span>
      </td>


      <td>
        <button
          type="button"
          class="delete-btn"
          data-delete="${index}"
        >
          Hapus
        </button>
      </td>

    `;


    table.appendChild(row);

  });

}


