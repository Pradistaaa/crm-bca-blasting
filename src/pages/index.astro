/* =====================================================
   PIC INLINE EDIT
   ===================================================== */

const pipelineDetailPicInput =
  document.getElementById(
    "pipelineDetailPic"
  );

const pipelinePicDisplay =
  document.getElementById(
    "pipelinePicDisplay"
  );

const pipelinePicName =
  document.getElementById(
    "pipelinePicName"
  );

const pipelinePicWrap =
  document.querySelector(
    ".pipeline-detail-pic-wrap"
  );

function startPicEdit() {

  if (!pipelinePicWrap) return;

  pipelineDetailPicInput.value =
  activePipelineLead?.pic || "";

  pipelinePicWrap.classList.add(
    "editing"
  );

  pipelineDetailPicInput.focus();

  pipelineDetailPicInput.select();
}


function savePicEdit() {

  if (
    !activePipelineLead ||
    !pipelinePicWrap
  ) {
    return;
  }

  const newPic =
    pipelineDetailPicInput.value.trim();

  activePipelineLead.pic = newPic;

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(leads)
  );

  pipelinePicName.textContent =
    newPic || "-";

  pipelinePicWrap.classList.remove(
    "editing"
  );

  renderPipeline();

  if (typeof render === "function") {
    render();
  }

  renderFollowup();
}


function cancelPicEdit() {

  if (!pipelinePicWrap) {
    return;
  }

  pipelineDetailPicInput.value =
    activePipelineLead?.pic || "";

  pipelinePicWrap.classList.remove(
    "editing"
  );
}


/* Klik PIC */

pipelinePicDisplay.addEventListener(
  "click",
  startPicEdit
);


/* Enter = simpan */

pipelineDetailPicInput.addEventListener(
  "click",
  (event) => {
    event.stopPropagation();
  }
);

pipelineDetailPicInput.addEventListener(
  "keydown",
  (event) => {

    if (event.key === "Enter") {

      event.preventDefault();

      savePicEdit();

    }

    if (event.key === "Escape") {

      event.preventDefault();

      cancelPicEdit();

    }

  }
);


/* Klik di luar = simpan */

document.addEventListener(
  "click",
  (event) => {

    if (
      !pipelinePicWrap ||
      !pipelinePicWrap.classList.contains(
        "editing"
      )
    ) {
      return;
    }

    if (
      !pipelinePicWrap.contains(
        event.target
      )
    ) {
      savePicEdit();
    }

  }
);

pipelineDetailModal.addEventListener(
  "click",
  (event) => {

    if (
      event.target ===
      pipelineDetailModal
    ) {
      pipelineDetailModal.classList.remove(
        "show"
      );
    }

  }
);

