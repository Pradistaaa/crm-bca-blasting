function renderReports() {
	const total = leads.length;

	const newCount = leads.filter(
		(lead) => lead.status === "new"
	).length;

	const contactedCount = leads.filter(
		(lead) => lead.status === "contacted"
	).length;

	const followupCount = leads.filter(
		(lead) => lead.status === "followup"
	).length;

	const closedCount = leads.filter(
		(lead) => lead.status === "closed"
	).length;

	document.getElementById("reportTotal").textContent = total;
	document.getElementById("reportNew").textContent = newCount;
	document.getElementById("reportContacted").textContent = contactedCount;
	document.getElementById("reportFollowup").textContent = followupCount;
	document.getElementById("reportClosed").textContent = closedCount;
}

			function saveLeads() {
				localStorage.setItem("crm_leads", JSON.stringify(leads));
			}

			function statusLabel(status) {
				const labels = {
					new: "Belum Dihubungi",
					contacted: "Sudah Dihubungi",
					followup: "Follow Up",
					closed: "Berhasil",
				};

				return labels[status] || status;
			}

			function render() {
				const query = search.value.toLowerCase().trim();
				const filter = statusFilter.value;

				const filtered = leads.filter((lead) => {
					const matchesSearch =
						lead.company.toLowerCase().includes(query) ||
						lead.pic.toLowerCase().includes(query) ||
						lead.city.toLowerCase().includes(query) ||
						lead.phone.includes(query);

					const matchesStatus =
						filter === "all" || lead.status === filter;

					return matchesSearch && matchesStatus;
				});

				table.innerHTML = "";

				if (!filtered.length) {
					table.innerHTML = `
						<tr>
							<td colspan="6" style="text-align:center;padding:40px;color:#697383">
								Tidak ada lead yang ditemukan.
							</td>
						</tr>
					`;
				}

				filtered.forEach((lead) => {
					const row = document.createElement("tr");

					row.innerHTML = `
	<td>
	<button
		class="company lead-link"
		data-detail-id="${lead.id}"
	>
		${lead.company}
	</button>
</td>

<td>
	<strong class="pic-name">${lead.pic}</strong>
</td>

<td>${lead.city}</td>

						<td>
							<button
								class="whatsapp"
								data-phone="${lead.phone}"
							>
								WhatsApp
							</button>
						</td>

						<td>
							<select
								class="status ${lead.status}"
								data-status-id="${lead.id}"
								style="
									border:0;
									cursor:pointer;
									outline:none;
								"
							>
								<option value="new" ${lead.status === "new" ? "selected" : ""}>
									Belum Dihubungi
								</option>
								<option value="contacted" ${lead.status === "contacted" ? "selected" : ""}>
									Sudah Dihubungi
								</option>
								<option value="followup" ${lead.status === "followup" ? "selected" : ""}>
									Follow Up
								</option>
								<option value="closed" ${lead.status === "closed" ? "selected" : ""}>
									Berhasil
								</option>
							</select>
						</td>

						<td>
	<div style="display:flex;gap:6px;">
		<button
			class="action"
			title="Edit lead"
			data-edit-id="${lead.id}"
			style="font-size:12px;"
		>
			Edit
		</button>

		<button
			class="action"
			title="Hapus lead"
			data-delete-id="${lead.id}"
			style="font-size:12px;color:#ff6f7d;"
		>
			Hapus
		</button>
	</div>
</td>
					`;

					table.appendChild(row);
				});

				updateStats();
			}

			function updateStats() {
				document.getElementById("totalLead").textContent = leads.length;

				document.getElementById("newLead").textContent =
					leads.filter((x) => x.status === "new").length;

				document.getElementById("contactedLead").textContent =
					leads.filter((x) => x.status === "contacted").length;

				document.getElementById("followupLead").textContent =
					leads.filter((x) => x.status === "followup").length;
			}

			let editingLeadId = null;

function showModal(lead = null) {
	modal.classList.add("open");

	if (lead) {
		editingLeadId = lead.id;

		document.querySelector(".modal-title").textContent = "Edit Lead";

		document.getElementById("company").value = lead.company;
		document.getElementById("pic").value = lead.pic;
		document.getElementById("city").value = lead.city;
		document.getElementById("phone").value = lead.phone;
		document.getElementById("leadStatus").value = lead.status;
	} else {
		editingLeadId = null;

		document.querySelector(".modal-title").textContent = "Tambah Lead";

		form.reset();
	}

	document.getElementById("company").focus();
}

			function hideModal() {
				modal.classList.remove("open");
				form.reset();
			}

			openModal.addEventListener("click", () => showModal());
openModalMobile.addEventListener("click", () => showModal());
			closeModal.addEventListener("click", hideModal);
			cancelModal.addEventListener("click", hideModal);

			modal.addEventListener("click", (event) => {
				if (event.target === modal) {
					hideModal();
				}
			});

			form.addEventListener("submit", (event) => {
	event.preventDefault();

	const company = document.getElementById("company").value.trim();
	const pic = document.getElementById("pic").value.trim();
	const city = document.getElementById("city").value.trim();
	const phone = document
		.getElementById("phone")
		.value.replace(/\D/g, "");
	const status = document.getElementById("leadStatus").value;

	if (editingLeadId !== null) {
	const lead = leads.find((x) => x.id === editingLeadId);

	if (lead) {
		lead.company = company;
		lead.pic = pic;
		lead.city = city;
		lead.phone = phone;
		lead.status = status;

		if (!Array.isArray(lead.activities)) {
			lead.activities = [];
		}

		lead.activities.push({
			id: Date.now(),
			type: "updated",
			note: "Data Lead diperbarui",
			date: new Date().toISOString(),
		});
	}
} else {
		const newLead = {
	id: Date.now(),
	company,
	pic,
	city,
	phone,
	status,
	activities: [
		{
			id: Date.now(),
			type: "created",
			note: "Lead dibuat dan ditambahkan ke CRM",
			date: new Date().toISOString(),
		},
	],
};

		leads.unshift(newLead);
	}

	saveLeads();
	render();
	hideModal();

	editingLeadId = null;
});

			search.addEventListener("input", render);
			statusFilter.addEventListener("change", render);

			table.addEventListener("click", (event) => {
				const detailButton = event.target.closest("[data-detail-id]");

if (detailButton) {
	const id = Number(detailButton.dataset.detailId);
	const lead = leads.find((x) => x.id === id);

	if (lead) {
		selectedLeadId = lead.id;

		document.getElementById("detailCompany").textContent =
			lead.company;

		document.getElementById("detailPic").textContent =
			`PIC: ${lead.pic}`;

		document.getElementById("detailCity").textContent =
			lead.city;

		document.getElementById("detailPhone").textContent =
			lead.phone;

		document.getElementById("detailStatus").textContent =
			statusLabel(lead.status);

			const activityList = document.getElementById("activityList");

const activities = Array.isArray(lead.activities)
	? lead.activities
	: [];

if (activities.length === 0) {
	activityList.innerHTML = `
		<div class="activity-empty">
			Belum ada aktivitas.
		</div>
	`;
} else {
	activityList.innerHTML = activities
		.slice()
		.reverse()
		.map((activity) => {
			const date = new Date(activity.date);

			return `
				<div class="activity-item">
					<strong>
	${activity.type === "created"
		? "🟢 Lead dibuat"
		: activity.type === "whatsapp"
			? "💬 WhatsApp"
			: activity.type === "call"
				? "📞 Telepon"
				: activity.type === "followup"
					? "🔵 Follow Up"
					: activity.type === "meeting"
						? "🤝 Meeting"
						: activity.type === "note"
							? "📝 Catatan"
							: activity.type === "status"
								? "🔄 Status Diubah"
								: activity.type === "updated"
									? "✏️ Lead Diperbarui"
									: activity.type}
</strong>

					<p>${activity.note}</p>

					<div class="activity-date">
						${date.toLocaleString("id-ID")}
					</div>
				</div>
			`;
		})
		.join("");
}

		detailModal.classList.add("open");
	}

	return;
}
				const editButton = event.target.closest("[data-edit-id]");

if (editButton) {
	const id = Number(editButton.dataset.editId);
	const lead = leads.find((x) => x.id === id);

	if (lead) {
		showModal(lead);
	}

	return;
}
				const whatsapp = event.target.closest(".whatsapp");

if (whatsapp) {
	const phone = whatsapp.dataset.phone;
	const id = Number(
		whatsapp.closest("tr")
			?.querySelector("[data-status-id]")
			?.dataset.statusId
	);

	const lead = leads.find((x) => x.id === id);

	if (lead) {
		if (!Array.isArray(lead.activities)) {
			lead.activities = [];
		}

		lead.activities.push({
			id: Date.now(),
			type: "whatsapp",
			note: "Membuka percakapan WhatsApp dengan customer",
			date: new Date().toISOString(),
		});

		saveLeads();

		const message =
			`Halo ${lead.pic}, perkenalkan saya dari CRM Blasting. ` +
			`Kami ingin menyampaikan informasi terkait produk kami. ` +
			`Apakah Bapak/Ibu berkenan jika saya jelaskan lebih lanjut?`;

		window.open(
			`https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
			"_blank"
		);
	}

	return;
}
				const select = event.target.closest("[data-status-id]");

				if (!select) return;

				const id = Number(select.dataset.statusId);
				const lead = leads.find((x) => x.id === id);

				if (lead) {
	const oldStatus = lead.status;
	const newStatus = select.value;

	lead.status = newStatus;

	if (!Array.isArray(lead.activities)) {
		lead.activities = [];
	}

	if (oldStatus !== newStatus) {
	lead.activities.push({
		id: Date.now(),
		type: "status",
		note: `Status diubah dari "${statusLabel(oldStatus)}" menjadi "${statusLabel(newStatus)}"`,
		date: new Date().toISOString(),
	});

	if (newStatus === "followup") {
		lead.activities.push({
			id: Date.now() + 1,
			type: "followup",
			note: "Lead ditandai untuk ditindaklanjuti",
			date: new Date().toISOString(),
		});
	}
}

	saveLeads();
	renderReports();
}
			});

			table.addEventListener("click", (event) => {
				const deleteButton = event.target.closest("[data-delete-id]");

				if (!deleteButton) return;

				const id = Number(deleteButton.dataset.deleteId);

				if (confirm("Hapus lead ini?")) {
					leads = leads.filter((lead) => lead.id !== id);
					saveLeads();
					render();
				}
			});

			render();
		</script>
	</body>
</html>