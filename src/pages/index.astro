  gap: 12px;
  margin-bottom: 18px;
}

#page-campaign .stat-card {
  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 12px;

  padding: 16px;
}

#page-campaign .stat-card span {
  display: block;

  color: #68756d;
  font-size: 10px;

  margin-bottom: 8px;
}

#page-campaign .stat-card strong {
  display: block;

  color: #f1f6f3;
  font-size: 22px;
}


/* CONTENT CARD */

#page-campaign .content-card {
  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 12px;

  overflow: hidden;
}

#page-campaign .content-card-header {
  padding: 16px 18px;

  border-bottom: 1px solid #25332b;
}

#page-campaign .content-card-header h3 {
  margin: 0;

  font-size: 13px;
  color: #f1f6f3;
}

#page-campaign .content-card-header p {
  margin: 5px 0 0;

  color: #68756d;
  font-size: 10px;
}


/* EMPTY CAMPAIGN */

#page-campaign #campaignList .empty-page {
  padding: 45px 20px;
}

#page-campaign #campaignList .empty-icon {
  margin-bottom: 12px;
}

#page-campaign #campaignList h2 {
  font-size: 14px;
}

#page-campaign #campaignList p {
  font-size: 10px;
}


/* RESPONSIVE */

@media (max-width: 800px) {

  #page-campaign .stats-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}

@media (max-width: 520px) {

  #page-campaign .page-header {
    flex-direction: column;
    align-items: flex-start;
  }

  #page-campaign .stats-grid {
    grid-template-columns: 1fr;
  }

}

