   ===================================================== */

.pipeline-detail-pic-wrap {
  position: relative;
}

.pipeline-pic-display {
  margin-top: 6px;
  min-height: 38px;
  padding: 0 12px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 9px;

  color: #e7eee9;
  font-size: 12px;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}

.pipeline-pic-display:hover {
  border-color: rgba(25,216,116,.45);
  background: #1a241f;
}

.pipeline-pic-edit {
  color: #68756d;
  font-size: 13px;
  transition: color .2s ease;
}

.pipeline-pic-display:hover .pipeline-pic-edit {
  color: #19d874;
}

.pipeline-pic-input {
  display: none;

  width: 100%;
  box-sizing: border-box;

  margin-top: 6px;
  min-height: 38px;

  padding: 0 12px;

  background: #171e1a;
  border: 1px solid #19d874;
  border-radius: 9px;

  color: #f2f7f4;
  font-size: 12px;

  outline: none;

  box-shadow:
    0 0 0 3px rgba(25,216,116,.08);
}

.pipeline-pic-input::placeholder {
  color: #68756d;
}

.pipeline-pic-hint {
  display: none;

  margin-top: 5px;

  color: #68756d;
  font-size: 9px;
}

.pipeline-detail-pic-wrap.editing
.pipeline-pic-display {
  display: none;
}

.pipeline-detail-pic-wrap.editing
.pipeline-pic-input {
  display: block !important;
  pointer-events: auto;
  position: relative;
  z-index: 20;
}

.pipeline-detail-pic-wrap.editing
.pipeline-pic-hint {
  display: block;
