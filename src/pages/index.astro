---
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LeadFlow CRM</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    :root {
      --bg: #080b09;
      --sidebar: #0d110f;
      --card: #121815;
      --card2: #171e1a;
      --border: #25332b;
      --green: #19d874;
      --green-dark: #0c9e51;
      --text: #f5fff9;
      --muted: #8d9a91;
      --yellow: #ffb020;
      --blue: #6ea8ff;
      --red: #ff5c5c;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    button,
    input,
    select {
      font-family: inherit;
    }

    .app {
      min-height: 100vh;
    }

    /* SIDEBAR */

    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      width: 250px;
      height: 100vh;
      background: var(--sidebar);
      border-right: 1px solid var(--border);
      padding: 22px 14px;
      z-index: 100;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 0 9px 25px;
      border-bottom: 1px solid var(--border);
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--green), #08783d);
      color: #001b0c;
      font-size: 22px;
      font-weight: bold;
    }

    .logo h2 {
      font-size: 19px;
    }

    .logo span {
      display: block;
      margin-top: 3px;
      color: var(--green);
      font-size: 9px;
      letter-spacing: 2px;
    }

    .menu-title {
      color: var(--muted);
      font-size: 9px;
      letter-spacing: 1.5px;
      margin: 22px 10px 9px;
    }

    .nav-item {
      width: 100%;
      border: 0;
      background: transparent;
      color: #aeb9b1;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 13px;
      border-radius: 9px;
      margin-bottom: 4px;
      cursor: pointer;
      font-size: 13px;
      text-align: left;
    }

    .nav-item:hover,
    .nav-item.active {
      background: rgba(25, 216, 116, 0.1);
      color: var(--green);
    }

    .nav-icon {
      width: 21px;
      text-align: center;
      font-size: 16px;
    }

    .badge {
      margin-left: auto;
      background: rgba(25, 216, 116, .13);
      color: var(--green);
      padding: 3px 7px;
      border-radius: 15px;
      font-size: 9px;
    }

    /* MAIN */

    .main {
      margin-left: 250px;
      padding: 30px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
    }

    .welcome h1 {
      font-size: 25px;
    }

    .welcome p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 7px;
    }

    .user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #18241c;
      color: var(--green);
      border: 1px solid var(--green-dark);
      font-weight: bold;
    }

    /* PAGE */

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    /* STATS */

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 20px;
    }

    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 20px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 11px;
    }

    .stat-value {
      font-size: 29px;
      font-weight: bold;
      margin-top: 11px;
    }

    .stat-sub {
      color: var(--green);
      font-size: 10px;
      margin-top: 6px;
    }

    /* CARDS */

    .content-grid {
      display: grid;
      grid-template-columns: 1.65fr 1fr;
      gap: 18px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 20px;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .card-header h3 {
      font-size: 15px;
    }

    .green-btn {
      border: 0;
      background: var(--green);
      color: #001b0c;
      font-weight: bold;
      border-radius: 9px;
      padding: 9px 13px;
      cursor: pointer;
      font-size: 11px;
    }

    .green-btn:hover {
      opacity: .9;
    }

/* DASHBOARD IMPROVEMENT */

.section-description {
  color: var(--muted);
  font-size: 10px;
  margin-top: 5px;
}

.dashboard-right {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.activity-card {
  min-height: 250px;
}

.empty-leads {
  padding: 45px 20px;
  text-align: center;
  border-top: 1px solid var(--border);
}

.empty-leads-icon {
  width: 45px;
  height: 45px;
  margin: 0 auto 12px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(25,216,116,.08);
  color: var(--green);
  font-size: 20px;
}

.empty-leads strong {
  display: block;
  font-size: 13px;
}

.empty-leads p {
  color: var(--muted);
  font-size: 10px;
  margin: 6px 0 14px;
}

.action-btn strong {
  display: block;
  font-size: 11px;
}

.action-btn small {
  line-height: 1.4;
}

.activity {
  display: flex;
  gap: 11px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.activity:last-child {
  border-bottom: 0;
}

.activity-icon {
  width: 34px;
  height: 34px;
  min-width: 34px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(25,216,116,.09);
  color: var(--green);
}

.activity h4 {
  font-size: 11px;
  margin-bottom: 4px;
}

.activity p {
  color: var(--muted);
  font-size: 9px;
  line-height: 1.5;
}

.activity-time {
  color: #637068;
  font-size: 8px;
  margin-top: 4px;
  display: block;
}

@media(max-width:1100px) {

  .dashboard-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

}

@media(max-width:768px) {

  .dashboard-right {
    display: flex;
  }

  .section-description {
    font-size: 9px;
  }

}

    /* TABLE */

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    th {
      text-align: left;
      color: var(--muted);
      font-size: 9px;
      font-weight: normal;
      padding: 0 8px 12px;
    }

   td {
  border-top: 1px solid var(--border);
  padding: 14px 8px;
  font-size: 11px;
  vertical-align: middle;
}

    .company {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .company-logo {
      width: 32px;
      height: 32px;
      min-width: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #1b2820;
      color: var(--green);
      font-weight: bold;
    }

    .company-info strong {
      display: block;
      font-size: 11px;
    }

    .company-info small {
      color: var(--muted);
      font-size: 9px;
      display: block;
      margin-top: 3px;
    }

    .pic-name {
      color: #e9fff2;
    }

    .whatsapp-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  text-decoration: none;
  color: var(--green);
  background: rgba(25,216,116,.08);
  border: 1px solid rgba(25,216,116,.15);
  border-radius: 7px;
  padding: 6px 8px;
  font-size: 10px;
  white-space: nowrap;
}

.whatsapp-link:hover {
  background: rgba(25,216,116,.16);
  color: var(--green);
}

    .category-text {
      color: #c5d0c9;
    }

    .status {
      display: inline-block;
      border-radius: 20px;
      padding: 5px 9px;
      font-size: 9px;
    }

    .status-new {
      color: var(--green);
      background: rgba(25,216,116,.1);
    }

    .status-follow {
      color: var(--yellow);
      background: rgba(255,176,32,.1);
    }

    .status-meeting {
      color: var(--blue);
      background: rgba(110,168,255,.1);
    }

    .status-deal {
      color: var(--green);
      background: rgba(25,216,116,.18);
    }

    .status.status-contacted {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 9px;
  font-weight: 500;
  white-space: nowrap;
  color: var(--blue) !important;
  background: rgba(110,168,255,.1) !important;
  border: 1px solid rgba(110,168,255,.12) !important;
}


    .delete-btn {
      border: 1px solid rgba(255,92,92,.2);
      color: var(--red);
      background: rgba(255,92,92,.06);
      border-radius: 7px;
      padding: 6px 9px;
      font-size: 9px;
      cursor: pointer;
    }

    /* ACTION */

    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .action-btn {
      background: var(--card2);
      color: white;
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 14px 11px;
      text-align: left;
      cursor: pointer;
    }

    .action-btn:hover {
      border-color: var(--green);
    }

    .action-btn span {
      color: var(--green);
      font-size: 18px;
      display: block;
      margin-bottom: 6px;
    }

    .action-btn small {
      display: block;
      color: var(--muted);
      margin-top: 4px;
      font-size: 9px;
    }

    /* MODAL */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.72);
      align-items: center;
      justify-content: center;
      z-index: 999;
      padding: 20px;
    }

    .modal.show {
      display: flex;
    }

    .modal-box {
      width: 100%;
      max-width: 480px;
      background: #101512;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-header h2 {
      font-size: 18px;
    }

    .close-btn {
      background: transparent;
      color: var(--muted);
      border: 0;
      font-size: 22px;
      cursor: pointer;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-group label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 11px;
      background: var(--card2);
      color: white;
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
      font-size: 12px;
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: var(--green);
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 9px;
      margin-top: 20px;
    }

    .cancel-btn {
      padding: 10px 14px;
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
    }

    /* SIMPLE PAGES */

    .empty-page {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 50px;
      text-align: center;
    }

    .empty-icon {
      font-size: 40px;
      margin-bottom: 15px;
    }

    .empty-page h2 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .empty-page p {
      color: var(--muted);
      font-size: 12px;
    }

/* =====================================================
   PIPELINE CRM
   ===================================================== */

.pipeline-board {
  display: grid;
  grid-template-columns: repeat(4, minmax(230px, 1fr));
  gap: 14px;
  align-items: start;
  overflow-x: auto;
  padding-bottom: 6px;
}

.pipeline-column {
  min-width: 230px;
  min-height: 430px;
  background: var(--card2);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px;
}

.pipeline-column-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 3px 2px 12px;
  margin-bottom: 12px;
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  font-weight: 700;
}

.pipeline-count {
  min-width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(25,216,116,.10);
  color: var(--green);
  font-size: 9px;
}

.pipeline-list {
  min-height: 100px;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

:global(.pipeline-card.dragging) {
  opacity: .45;
  transform: rotate(1deg) scale(.98);
}

:global(.pipeline-list.drag-over) {
  background: rgba(25,216,116,.05);
  border-radius: 10px;
}

:global(.pipeline-detail-modal) {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 9999;
}

:global(.pipeline-detail-modal.show) {
  display: flex;
}

:global(.pipeline-detail-box) {
  width: min(440px, 100%);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0,0,0,.45);
  overflow: hidden;
}

:global(.pipeline-detail-header) {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

:global(.pipeline-detail-label) {
  display: block;
  color: var(--green);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin-bottom: 6px;
}

:global(.pipeline-detail-header h2) {
  font-size: 18px;
  line-height: 1.35;
}

:global(.pipeline-detail-close) {
  width: 32px;
  height: 32px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  font-size: 20px;
  cursor: pointer;
}

:global(.pipeline-detail-close:hover) {
  color: var(--text);
  background: rgba(255,255,255,.05);
}

:global(.pipeline-detail-body) {
  padding: 18px 20px 20px;
  display: grid;
  gap: 12px;
}

:global(.pipeline-detail-item) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 11px 0;
  border-bottom: 1px solid rgba(255,255,255,.05);
}

:global(.pipeline-detail-item:last-child) {
  border-bottom: 0;
}

:global(.pipeline-detail-item span) {
  color: var(--muted);
  font-size: 10px;
}

:global(.pipeline-detail-item strong) {
  color: var(--text);
  font-size: 11px;
  text-align: right;
}

:global(.pipeline-status-select) {
  min-width: 170px;
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card2);
  color: var(--text);
  font-size: 11px;
  outline: none;
  cursor: pointer;
}

:global(.pipeline-status-select:focus) {
  border-color: var(--green);
}

:global(.pipeline-status-select option) {
  background: var(--card);
  color: var(--text);
}

:global(.pipeline-card) {
  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 11px;
  padding: 12px;
  margin-bottom: 0;
  transition: all .2s ease;
  box-sizing: border-box;
}

:global(.pipeline-card:hover) {
  border-color: rgba(25,216,116,.35);
  transform: translateY(-1px);
}

:global(.pipeline-card-company) {
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 6px;
}

:global(.pipeline-card-pic) {
  font-size: 10px;
  color: #8d9a91;
  margin-bottom: 5px;
}

:global(.pipeline-card-category) {
  display: inline-block;
  padding: 3px 7px;
  border-radius: 5px;
  background: rgba(255,255,255,.05);
  color: #8d9a91;
  font-size: 9px;
  font-weight: 600;
}

@media(max-width:1100px) {
  .pipeline-board {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }
}

@media(max-width:768px) {
  .pipeline-board {
    grid-template-columns: repeat(4, 220px);
    overflow-x: auto;
  }
}

    /* MOBILE */

    .mobile-header {
      display: none;
    }

    @media(max-width:1100px) {
      .stats {
        grid-template-columns: repeat(2,1fr);
      }

      .content-grid {
        grid-template-columns: 1fr;
      }
    }

    @media(max-width:768px) {
      .sidebar {
        display: none;
      }

      .main {
        margin-left: 0;
        padding: 18px 15px;
      }

      .mobile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
      }

      .mobile-logo {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .mobile-logo .logo-icon {
        width: 36px;
        height: 36px;
      }

      .mobile-menu {
        background: var(--card);
        color: var(--green);
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 9px 12px;
      }

      .topbar {
        margin-bottom: 20px;
      }

      .topbar .user {
        display: none;
      }

      .welcome h1 {
        font-size: 21px;
      }

      .stats {
        gap: 9px;
      }

      .stat-card {
        padding: 15px;
      }

      .stat-value {
        font-size: 23px;
      }

      .card {
        padding: 15px;
      }
    }

/* =====================================================
   FINAL DASHBOARD POLISH
   ===================================================== */

/* Grid tidak memaksa card kiri mengikuti tinggi kanan */
.content-grid {
  align-items: start;
}

/* Card database mengikuti isi */
.content-grid > .card {
  height: auto;
  min-height: 0;
  align-self: start;
}

/* Header database */
.card-header {
  margin-bottom: 16px;
}

/* Tabel lebih compact dan rapi */
.table-wrap {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  table-layout: auto;
}

th {
  padding: 0 10px 10px;
  font-size: 9px;
  letter-spacing: .6px;
  white-space: nowrap;
}

td {
  padding: 13px 10px;
  vertical-align: middle;
  white-space: nowrap;
}

/* Perusahaan */
.company {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 230px;
}

.company-logo {
  width: 34px;
  height: 34px;
  min-width: 34px;
  border-radius: 9px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(25,216,116,.10);
  border: 1px solid rgba(25,216,116,.16);

  color: var(--green);
  font-size: 13px;
  font-weight: 700;
}

.company-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.company-info strong {
  display: block;
  color: var(--text);
  font-size: 11px;
  font-weight: 600;
  line-height: 1.3;
  white-space: normal;
}

.company-info small {
  display: none;
}

/* PIC */
.pic-name {
  color: #e8f0eb;
  font-size: 11px;
  white-space: nowrap;
}

/* =====================================================
   WHATSAPP
   ===================================================== */

.whatsapp-link,
.whatsapp-link:visited,
.whatsapp-link:active {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  color: var(--green) !important;
  text-decoration: none !important;

  background: rgba(25,216,116,.08);
  border: 1px solid rgba(25,216,116,.16);

  border-radius: 7px;
  padding: 5px 8px;

  font-size: 10px;
  line-height: 1;

  transition: .2s;
}

.whatsapp-link:hover {
  color: #ffffff !important;
  background: rgba(25,216,116,.16);
  border-color: rgba(25,216,116,.35);
  transform: translateY(-1px);
}

/* =====================================================
   CATEGORY
   ===================================================== */

.category-text {
  color: #c8d2cc;
  font-size: 10px;
  white-space: nowrap;
}

/* =====================================================
   STATUS
   ===================================================== */

.status {
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 9px;
  font-weight: 500;
  white-space: nowrap;
}

.status.new {
