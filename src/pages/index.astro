	if (!lead) return;

	if (!Array.isArray(lead.activities)) {
		lead.activities = [];
	}

	lead.activities.push({
		id: Date.now(),
		type: activityType.value,
		note: activityNote.value.trim(),
		date: new Date().toISOString(),
	});

	saveLeads();

	activityForm.reset();
