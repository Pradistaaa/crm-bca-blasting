let activePipelineLead = null;   

function renderFollowup() {

  document.addEventListener("click", (event) => {

  const button =
    event.target.closest("[data-followup-detail]");

  if (!button) {
    return;
  }

  const leadId =
    Number(button.dataset.followupDetail);

  const lead =
    leads.find(
      item => Number(item.id) === leadId
    );

  if (!lead) {
    return;
  }

  activePipelineLead = lead;

  document.getElementById(
    "pipelineDetailCompany"
  ).textContent =
    lead.company || "-";

  document.getElementById(
  "pipelinePicName"
).textContent =
  lead.pic || "-";

document.getElementById(
  "pipelineDetailPic"
).value =
  lead.pic || "";

  document.getElementById(
    "pipelineDetailWhatsapp"
  ).textContent =
    lead.whatsapp || "-";

  document.getElementById(
    "pipelineDetailCategory"
  ).textContent =
    lead.category || "-";

  const statusSelect =
    document.getElementById(
      "pipelineDetailStatus"
    );

  if (statusSelect) {
    statusSelect.value =
      lead.status || "new";
  }

  const modal =
    document.getElementById(
      "pipelineDetailModal"
    );

  if (modal) {
    modal.classList.add("show");
  }

});

  const table =
    document.getElementById("followupTable");

  const empty =
    document.getElementById("followupEmpty");

  const count =
    document.getElementById("followupPageCount");

  const sidebarCount =
    document.getElementById("followupCount");

  if (!table) {
    return;
  }

  const followups =
    leads.filter(
      lead => lead.status === "follow"
    );

  table.innerHTML = "";

  followups.forEach((lead) => {

    const row =
      document.createElement("tr");

    row.innerHTML = `
  <td>
    <div class="company">
      <div class="company-logo">
        ${(lead.company || "L").charAt(0).toUpperCase()}
      </div>

      <div class="company-info">
        <strong>${lead.company || "-"}</strong>
      </div>
    </div>
  </td>

  <td>
    <span class="pic-name">
      ${lead.pic || "-"}
    </span>
  </td>

  <td>
    ${
      lead.whatsapp
        ? `
          <a
            href="https://wa.me/${String(lead.whatsapp).replace(/\D/g, '')}"
            target="_blank"
            rel="noopener"
            class="whatsapp-link"
          >
            ${lead.whatsapp}
          </a>
        `
        : "-"
    }
  </td>

  <td>
    <span class="category-text">
      ${lead.category || "-"}
    </span>
  </td>

  <td>
    <span class="status status-follow">
      Follow-up
    </span>
  </td>

  <td class="followup-action-cell">
    <button
  class="followup-action-btn"
  type="button"
  data-followup-detail="${lead.id}"
>
  Lihat
</button>
  </td>
`;

    table.appendChild(row);
  });

  const total = followups.length;

  if (count) {
    count.textContent = total;
  }

  if (sidebarCount) {
    sidebarCount.textContent = total;
  }

  if (empty) {
    empty.style.display =
      total === 0 ? "block" : "none";
  }

  table.style.display =
    total === 0 ? "none" : "table";
}


function renderPipeline() {

  const pipelineNew =
    document.getElementById("pipelineNew");

  const pipelineContacted =
    document.getElementById("pipelineContacted");

  const pipelineFollow =
    document.getElementById("pipelineFollow");

  const pipelineDeal =
    document.getElementById("pipelineDeal");

  if (
    !pipelineNew ||
    !pipelineContacted ||
    !pipelineFollow ||
    !pipelineDeal
  ) {
    return;
  }

  pipelineNew.innerHTML = "";
  pipelineContacted.innerHTML = "";
  pipelineFollow.innerHTML = "";
  pipelineDeal.innerHTML = "";

  const columns = {
    new: pipelineNew,
    contacted: pipelineContacted,
    follow: pipelineFollow,
    deal: pipelineDeal
  };

  Object.entries(columns).forEach(
  ([status, column]) => {

    column.addEventListener(
      "dragover",
      (event) => {
        event.preventDefault();
        column.querySelector(".pipeline-list")
  ?.classList.add("drag-over");
      }
    );

    column.addEventListener(
      "dragleave",
      () => {
        column.querySelector(".pipeline-list")
  ?.classList.remove("drag-over");
      }
    );

    column.addEventListener(
      "drop",
      (event) => {

        event.preventDefault();

        column.classList.remove(
          "drag-over"
        );

        const card =
          document.querySelector(
            ".pipeline-card.dragging"
          );

        if (!card) {
          return;
        }

        const leadId =
          Number(card.dataset.pipelineId);

        const lead =
          leads.find(
            item =>
              Number(item.id) === leadId
          );

        if (!lead) {
          return;
        }

        lead.status = status;

        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify(leads)
        );

        renderPipeline();

        if (typeof render === "function") {
          render();
        }

        renderFollowup();

      }
    );

  }
);

  const counts = {
    new: 0,
    contacted: 0,
    follow: 0,
    deal: 0
  };

  leads.forEach((lead) => {

    let status = lead.status || "new";

    if (!columns[status]) {
      status = "new";
    }

    const card = document.createElement("div");

    card.className = "pipeline-card";

    card.draggable = true;

    card.addEventListener("dragstart", () => {
  card.classList.add("dragging");
  card.dataset.dragging = "true";
});

card.addEventListener("dragend", () => {
  card.classList.remove("dragging");
  card.dataset.dragging = "false";
});

    card.dataset.pipelineId = lead.id;

    card.innerHTML = `

      <div class="pipeline-card-company">
        ${lead.company || "Tanpa Nama"}
      </div>

      <div class="pipeline-card-pic">
        ${lead.pic || "-"}
      </div>

      <div class="pipeline-card-category">
        ${lead.category || "-"}
      </div>
    `;

    columns[status].appendChild(card);

    counts[status]++;
  });

  pipelineNewCount.textContent =
    counts.new;

  pipelineContactedCount.textContent =
    counts.contacted;

  pipelineFollowCount.textContent =
    counts.follow;

  pipelineDealCount.textContent =
    counts.deal;
}

renderPipeline();
renderFollowup();

