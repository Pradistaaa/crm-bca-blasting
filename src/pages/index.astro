const saveCampaignBtn =
  document.getElementById("saveCampaignBtn");

const campaignNameInput =
  document.getElementById("campaignNameInput");

const campaignTargetInput =
  document.getElementById("campaignTargetInput");

const campaignCategoryInput =
  document.getElementById("campaignCategoryInput");

const campaignStatusInput =
  document.getElementById("campaignStatusInput");

const campaignMessageInput =
  document.getElementById("campaignMessageInput");


const CAMPAIGN_STORAGE_KEY =
  "leadflow_campaigns";


let campaigns = JSON.parse(
  localStorage.getItem(
    CAMPAIGN_STORAGE_KEY
  ) || "[]"
);

function updateCampaignStats() {

  const totalCampaign =
    document.getElementById("campaignTotal");

  if (totalCampaign) {
    totalCampaign.textContent =
      campaigns.length;
  }

}

function renderCampaigns() {

  const campaignList =
    document.getElementById("campaignList");

  if (!campaignList) return;

  if (campaigns.length === 0) {

    campaignList.innerHTML = `
      <div class="empty-page">

        <div class="empty-icon">
          ✉
        </div>

        <h2>
          Belum ada Campaign
        </h2>

        <p>
          Buat campaign pertama untuk mulai follow-up lead.
        </p>

      </div>
    `;

    return;
  }

  campaignList.innerHTML =
    campaigns.map((campaign) => {

      const targetLabel =
        campaign.target === "filtered"
          ? "Lead Terpilih"
          : "Semua Lead";

      const categoryLabel =
        campaign.category ||
        "Semua Kategori";

      const statusLabel =
        campaign.status === "new"
          ? "New"
          : campaign.status === "contacted"
          ? "Sudah Dihubungi"
          : campaign.status === "follow"
          ? "Follow-up"
          : campaign.status === "deal"
          ? "Deal"
          : "Semua Status";

      return `
        <div class="campaign-item">

          <div class="campaign-item-top">

            <div>
              <strong class="campaign-item-title">
                ${campaign.name}
              </strong>

              <div class="campaign-meta">

                <span>
                  🎯 ${targetLabel}
                </span>

                <span>
                  🏷 ${categoryLabel}
                </span>

                <span>
                  ● ${statusLabel}
                </span>

              </div>

            </div>

          </div>


          <div class="campaign-message-preview">

            ${campaign.message}

          </div>


          <div class="campaign-actions">

            <button
              type="button"
              class="campaign-view-btn"
              data-campaign-view="${campaign.id}"
            >
              👁 Lihat
            </button>

            <button
              type="button"
              class="campaign-edit-btn"
              data-campaign-edit="${campaign.id}"
            >
              ✎ Edit
            </button>

            <button
              type="button"
              class="campaign-delete-btn"
              data-campaign-delete="${campaign.id}"
            >
              🗑 Hapus
            </button>

          </div>

        </div>
      `;

    }).join("");

}

saveCampaignBtn?.addEventListener(
  "click",
  () => {

    const name =
      campaignNameInput.value.trim();

    const message =
      campaignMessageInput.value.trim();


    if (!name) {

      alert(
        "Nama Campaign wajib diisi."
      );

      campaignNameInput.focus();

      return;
    }


    if (!message) {

      alert(
        "Pesan WhatsApp wajib diisi."
      );

      campaignMessageInput.focus();

      return;
    }


    const campaign = {

      id: Date.now(),

      name,

      target:
        campaignTargetInput.value,

      category:
        campaignCategoryInput.value,

      status:
        campaignStatusInput.value,

      message,

      createdAt:
        new Date().toISOString()

    };


    campaigns.unshift(
      campaign
    );


    localStorage.setItem(
      CAMPAIGN_STORAGE_KEY,
      JSON.stringify(campaigns)
    );


    alert(
      "Campaign berhasil disimpan."
    );

    updateCampaignStats();
    renderCampaigns();

    console.log(
      "Campaign tersimpan:",
      campaign
    );

  }
);

